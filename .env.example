# NEXORA AI PRO MAX — Environment Configuration Example
# Copy this file to .env or .env.local and populate the keys for the services you use.

# ==============================================================================
# 1. PRIMARY AI ENGINE — GOOGLE GEMINI
# Required for: AI Chat, Exam Answer Writer, Quiz Generator, Summarizer, Code Helper, Multimodal Vision OCR
# Get API Key: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative alias supported:
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# 2. SUPABASE BACKEND (Database, Auth, History & Storage)
# Required for: User Authentication, Profile Preferences, Cloud AI Generation History, RLS
# Connect in Lovable Cloud or get keys from https://supabase.com/dashboard
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# ==============================================================================
# 3. OPTIONAL ALTERNATIVE TEXT AI PROVIDERS
# Used when selecting OpenAI GPT-4o or Anthropic Claude in model dropdowns
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# 4. LIVE WEB GROUNDING & SEARCH API
# Required for: Research Lab Web Grounding & Live Citation Verification
# Get API Key: https://tavily.com
# ==============================================================================
TAVILY_API_KEY=

# ==============================================================================
# 5. CODE EXECUTION SANDBOX
# Required for: Isolated Containerized Execution (Judge0)
# Get API Key: https://judge0.com
# ==============================================================================
JUDGE0_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com

# ==============================================================================
# 6. IMAGE GENERATION ENGINE
# Required for: Text-to-Image Generation Studio
# ==============================================================================
IMAGE_GENERATION_API_KEY=

